              className={`p-2 rounded-xl border transition-all flex items-center gap-2 text-xs font-medium ${
                apiKey
                  ? 'bg-violet-950/50 border-violet-700/60 text-violet-300'
                  : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-slate-200 hover:border-slate-700'
              }`}
            >
              <Key className="w-4 h-4 text-violet-400" />
              <span className="hidden md:inline">{apiKey ? 'Gemini Active' : 'API Key'}</span>
