      timer = setInterval(() => {
        setCurrentSubtitleIdx(prev => (prev + 1) % activeClip.subtitles.length);
      }, 2500);
    } else {
      setCurrentSubtitleIdx(0);
    }
    return () => clearInterval(timer);
  }, [isPlaying, activeClip]);

