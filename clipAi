                </h2>
                <p className="text-xs text-slate-400">
                  Ditemukan {clips.length} segmen berpotensi tinggi untuk dipublikasikan ke TikTok/Reels/Shorts.
                </p>
              </div>
            </div>

            {/* Main Grid Layout: Left Player, Right List */}
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              
              {/* VIDEO PLAYER PREVIEW CARD (COL-5) */}
              <div className="lg:col-span-5 sticky top-24 space-y-4">
                <div className="bg-slate-900 border border-slate-800 rounded-3xl p-4 shadow-2xl overflow-hidden">
                  <div className="flex items-center justify-between mb-3 px-1">
                    <span className="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                      <Tv className="w-4 h-4 text-violet-400" />
                      Live Subtitle Preview
                    </span>
                    <span className="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400">
                      Ratio {aspectRatio}
                    </span>
                  </div>

                  {/* Canvas / Dynamic Vertical Player simulation */}
                  <div className="relative aspect-[9/16] w-full max-w-[320px] mx-auto rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 group shadow-inner">
                    {/* Background image preview */}
                    <img
                      src={activeClip?.videoBg}
                      alt="Clip Preview"
                      className="w-full h-full object-cover opacity-80 group-hover:scale-105 transition duration-500"
                    />

                    {/* Dark gradient overlays */}
                    <div className="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/80"></div>

                    {/* Top Stats Overlay */}
                    <div className="absolute top-3 left-3 right-3 flex items-center justify-between">
                      <span className="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-bold text-amber-400 border border-amber-500/30 flex items-center gap-1">
                        <Flame className="w-3 h-3 fill-amber-400" />
                        Viral Score {activeClip?.viralScore}
                      </span>
                      <span className="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-[10px] font-medium text-slate-300">
                        {activeClip?.duration}
                      </span>
                    </div>

                    {/* CENTER DYNAMIC SUBTITLE SIMULATION */}
                    <div className="absolute inset-x-4 bottom-24 text-center">
                      <div className="inline-block px-4 py-2 rounded-xl backdrop-blur-md bg-black/70 border border-white/10 shadow-2xl transform transition-all duration-300">
                        <p className={`text-sm sm:text-base font-extrabold uppercase tracking-wide ${
                          subtitleStyle === 'hormozi' 
                            ? 'text-yellow-400 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]'
                            : subtitleStyle === 'neon'
                            ? 'text-cyan-300 drop-shadow-[0_0_8px_rgba(6,182,212,0.8)]'
                            : 'text-white'
                        }`}>
                          {activeClip?.subtitles?.[currentSubtitleIdx]?.text || activeClip?.hook}
                        </p>
                      </div>
                    </div>

                    {/* Play / Pause Toggle overlay */}
                    <button
                      onClick={() => setIsPlaying(!isPlaying)}
                      className="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 group-hover:opacity-100 transition duration-300"
                    >
                      <div className="w-14 h-14 rounded-full bg-violet-600/90 text-white flex items-center justify-center shadow-xl">
                        {isPlaying ? <Pause className="w-6 h-6" /> : <Play className="w-6 h-6 ml-1" />}
                      </div>
                    </button>
                  </div>

                  {/* Player Controls */}
                  <div className="mt-4 flex items-center justify-between px-2">
                    <button
                      onClick={() => setIsPlaying(!isPlaying)}
                      className="flex items-center gap-2 text-xs font-semibold px-4 py-2 rounded-xl bg-violet-600 hover:bg-violet-500 text-white transition"
                    >
                      {isPlaying ? <Pause className="w-3.5 h-3.5" /> : <Play className="w-3.5 h-3.5" />}
                      {isPlaying ? 'Pause Preview' : 'Play Preview'}
                    </button>

                    <button
                      onClick={() => alert(`Simulasi Download Clip MP4: "${activeClip?.title}"`)}
                      className="flex items-center gap-1.5 text-xs font-medium px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition"
                    >
                      <Download className="w-3.5 h-3.5 text-cyan-400" />
                      Download MP4
                    </button>
                  </div>
                </div>
              </div>

              {/* CLIPS LIST GRID (COL-7) */}
              <div className="lg:col-span-7 space-y-4">
                {clips.map((clip) => {
                  const isSelected = activeClip?.id === clip.id;
                  return (
                    <div
                      key={clip.id}
                      onClick={() => {
                        setActiveClip(clip);
                        setIsPlaying(true);
                      }}
                      className={`p-5 rounded-3xl border transition-all cursor-pointer relative overflow-hidden ${
                        isSelected
                          ? 'bg-slate-900 border-violet-500/80 shadow-xl shadow-violet-950/50 ring-1 ring-violet-500/50'
                          : 'bg-slate-900/60 border-slate-800 hover:border-slate-700 hover:bg-slate-900/90'
                      }`}
                    >
                      <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-3">
                        <div className="flex items-center gap-2">
                          <span className="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center gap-1">
                            <Flame className="w-3 h-3 fill-amber-400" />
                            Viral Score: {clip.viralScore}
                          </span>
                          <span className="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-800 text-slate-300">
                            {clip.timestamp} ({clip.duration})
                          </span>
                        </div>

                        <span className="text-[10px] font-bold uppercase tracking-wider text-violet-400 bg-violet-500/10 px-2 py-0.5 rounded-md border border-violet-500/20">
                          {clip.badge}
                        </span>
                      </div>

                      <h3 className="text-base font-bold text-white mb-2 leading-snug">
                        {clip.title}
                      </h3>

                      {/* AI Explanation */}
                      <p className="text-xs text-slate-400 mb-4 bg-slate-950/60 p-3 rounded-xl border border-slate-800/80">
                        <strong className="text-violet-400 font-semibold">Why it will go viral:</strong> {clip.explanation}
                      </p>

                      {/* Suggested Hook */}
                      <div className="space-y-1 mb-4">
                        <span className="text-[11px] font-semibold text-slate-400 uppercase">Suggested Opening Hook:</span>
                        <p className="text-xs text-slate-200 italic bg-violet-950/30 p-2.5 rounded-xl border border-violet-800/40">
                          "{clip.hook}"
                        </p>
                      </div>

                      {/* Caption & Copy Action */}
                      <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-2 border-t border-slate-800/60">
                        <div className="text-xs text-slate-400 truncate max-w-md">
                          <span className="text-slate-500">Caption: </span>
                          <span className="text-slate-300">{clip.caption}</span>
                        </div>

                        <div className="flex items-center gap-2 w-full sm:w-auto justify-end">
                          <button
                            type="button"
                            onClick={(e) => {
                              e.stopPropagation();
                              copyToClipboard(clip.caption, `cap-${clip.id}`);
                            }}
                            className="flex items-center gap-1 text-[11px] font-medium px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition"
                          >
                            {copiedId === `cap-${clip.id}` ? (
                              <>
                                <Check className="w-3 h-3 text-emerald-400" />
                                <span className="text-emerald-400">Copied!</span>
                              </>
                            ) : (
                              <>
                                <Copy className="w-3 h-3" />
                                <span>Copy Caption</span>
                              </>
                            )}
                          </button>

                          <button
                            type="button"
                            onClick={(e) => {
                              e.stopPropagation();
                              setActiveClip(clip);
                              setIsPlaying(true);
                            }}
                            className="flex items-center gap-1 text-[11px] font-semibold px-3.5 py-1.5 rounded-lg bg-violet-600 hover:bg-violet-500 text-white transition"
                          >
                            <Play className="w-3 h-3 fill-white" />
                            <span>Preview</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>

            </div>
          </div>
        )}

        {/* FEATURES INFOGRAPHIC / FOOTER PROMO */}
        <div className="border-t border-slate-800/80 pt-12 mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div className="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 space-y-2">
            <div className="w-9 h-9 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 mb-3">
              <Sparkles className="w-5 h-5" />
            </div>
            <h4 className="font-bold text-white text-sm">AI Emotion & Spike Detection</h4>
            <p className="text-xs text-slate-400 leading-relaxed">
              Gemini AI memindai transkrip video untuk menemukan hook dramatis dan poin kunci yang paling memancing engagement pengguna.
            </p>
          </div>

          <div className="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 space-y-2">
            <div className="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-3">
              <Subtitles className="w-5 h-5" />
            </div>
            <h4 className="font-bold text-white text-sm">Dynamic Animated Captions</h4>
            <p className="text-xs text-slate-400 leading-relaxed">
              Subtitle otomatis beranimasi ala Alex Hormozi lengkap dengan keyword highlighting dan emoji untuk retensi penonton hingga 85%.
            </p>
          </div>

          <div className="p-6 rounded-2xl bg-slate-900/40 border border-slate-800/80 space-y-2">
            <div className="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-3">
              <Smartphone className="w-5 h-5" />
            </div>
            <h4 className="font-bold text-white text-sm">Auto 9:16 Smart Reframing</h4>
            <p className="text-xs text-slate-400 leading-relaxed">
              Otomatis melacak posisi pembicara utama dan mengubah video lanskap menjadi format potret TikTok/Reels presisi tinggi.
            </p>
          </div>
        </div>

      </main>
    </div>
  );
}
