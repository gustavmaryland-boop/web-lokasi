  // Processing & Simulation States
  const [isProcessing, setIsProcessing] = useState(false);
  const [progressStage, setProgressStage] = useState(0);
  const [progressPercent, setProgressPercent] = useState(0);
  const [clips, setClips] = useState([]);
  const [copiedId, setCopiedId] = useState(null);
  const [activeClip, setActiveClip] = useState(null);
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentSubtitleIdx, setCurrentSubtitleIdx] = useState(0);

  // Stage Messages for Processing Simulator
  const stages = [
    { title: 'Fetching Video Data', detail: 'Extracting transcript, metadata, and audio spectrum...' },
    { title: 'AI Analyzing Viral Hooks', detail: 'Scanning for high emotional spikes and engaging moments using Gemini...' },
    { title: 'Refining & Re-framing', detail: 'Auto-cropping subjects to dynamic vertical frame...' },
    { title: 'Generating Dynamic Subtitles', detail: 'Applying animation, highlight keywords, and auto-emojis...' },
    { title: 'Finalizing Clips', detail: 'Rendering preview clips and computing virality score...' }
  ];

  // Handle URL Paste
  const handlePaste = async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text.includes('youtube.com') || text.includes('youtu.be')) {
        setYoutubeUrl(text);
      } else {
        alert('Standard paste: Please make sure the clipboard contains a valid YouTube link.');
      }
    } catch (err) {
      console.error('Failed to read clipboard', err);
    }
  };

  // Call Gemini API if Key is present, or fallback to smart generator
  const analyzeWithGemini = async (url) => {
    if (!apiKey.trim()) return null;

    try {
      const systemPrompt = `You are a world-class viral video editor & short-form growth strategist (Opus Clip expert).
Analyze this YouTube URL: "${url}".
Generate 3 viral short clips suggestions based on common high-engagement topics for this kind of video.
Respond with a strictly valid JSON array of objects with keys:
"title" (string), "viralScore" (number 80-99), "badge" ("High Potential" or "Trending Topic"),
"timestamp" (string like "03:15 - 04:00"), "duration" (string like "45s"),
"explanation" (string explaining why it is viral),
"hook" (engaging 1-sentence hook),
"caption" (social caption with hashtags),
"subtitles" (array of objects with "start", "end", "text").`;

      const apiEndpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const res = await fetch(apiEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: systemPrompt }] }],
          generationConfig: { responseMimeType: "application/json" }
        })
      });

      if (!res.ok) throw new Error('Gemini API call failed');

      const data = await res.json();
      const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
      if (rawText) {
        const parsed = JSON.parse(rawText);
        // Enrich with mock backgrounds for preview player
        return parsed.map((item, idx) => ({
          ...item,
          id: `gemini-clip-${idx}`,
          videoBg: MOCK_GENERATED_CLIPS[idx % MOCK_GENERATED_CLIPS.length].videoBg
        }));
      }
    } catch (e) {
      console.warn('Gemini analysis failed or key invalid, using simulation fallback:', e);
    }
    return null;
  };

  // Start Generation Process
  const handleGenerate = async () => {
    if (!youtubeUrl.trim()) return;

    setIsProcessing(true);
    setProgressStage(0);
    setProgressPercent(0);
    setClips([]);

    // Start progress animation
    const totalDuration = 4500; // 4.5 sec simulation
    const intervalTime = 100;
    const increment = 100 / (totalDuration / intervalTime);

    let currentPercent = 0;
    const interval = setInterval(() => {
      currentPercent += increment;
      if (currentPercent >= 100) {
        currentPercent = 100;
        clearInterval(interval);
      }
      setProgressPercent(Math.floor(currentPercent));
      setProgressStage(Math.min(Math.floor((currentPercent / 100) * stages.length), stages.length - 1));
    }, intervalTime);

    // Call Gemini or fallback concurrently
    const apiResult = await analyzeWithGemini(youtubeUrl);

    setTimeout(() => {
      clearInterval(interval);
      setIsProcessing(false);
      const finalClips = apiResult || MOCK_GENERATED_CLIPS;
      setClips(finalClips);
      setActiveClip(finalClips[0]);
      setCredits(prev => Math.max(0, prev - 15));
    }, totalDuration);
  };

